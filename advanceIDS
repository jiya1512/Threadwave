# =========================
# LAYER 12: SUSPICIOUS HEADERS
# =========================
def check_suspicious_headers(headers):
    """Check for suspicious HTTP headers"""
    
    # Missing or suspicious User-Agent
    if 'user-agent' not in headers or headers['user-agent'] == '':
        return True, "Suspicious_Headers: Missing User-Agent", "MEDIUM", {"header": "user-agent"}
    
    # Suspicious X-Forwarded headers (proxy bypass attempts)
    suspicious_xff = ['127.0.0.1', 'localhost', '::1', '0.0.0.0']
    if 'x-forwarded-for' in headers:
        for ip in suspicious_xff:
            if ip in headers['x-forwarded-for']:
                return True, "Suspicious_Headers: X-Forwarded-For Manipulation", "MEDIUM", {"ip": ip}
    
    return False, None, "LOW", {}


# =========================
# LAYER 13: FILE UPLOAD ATTACKS
# =========================
def check_file_upload_attack(req):
    """Detect malicious file uploads"""
    
    if req.files:
        for file_key in req.files:
            file = req.files[file_key]
            filename = file.filename.lower()
            
            # Dangerous extensions
            dangerous_exts = ['.php', '.jsp', '.asp', '.aspx', '.exe', '.sh', '.bat', '.cmd', '.ps1']
            if any(filename.endswith(ext) for ext in dangerous_exts):
                return True, f"File_Upload: Dangerous Extension ({filename})", "CRITICAL", {"filename": filename}
            
            # Double extension
            if filename.count('.') > 1:
                return True, f"File_Upload: Double Extension ({filename})", "HIGH", {"filename": filename}
    
    return False, None, "LOW", {}


# =========================
# LAYER 14: HTTP REQUEST SMUGGLING
# =========================
def check_http_smuggling(req):
    """Detect HTTP request smuggling attempts"""
    
    # Check for conflicting Content-Length and Transfer-Encoding
    if 'content-length' in req.headers and 'transfer-encoding' in req.headers:
        return True, "HTTP_Smuggling: Conflicting Headers", "HIGH", {"type": "cl-te"}
    
    return False, None, "LOW", {}