# =========================
# ADVANCED MALICIOUS DETECTION
# =========================

def is_malicious(req):
    """
    Advanced multi-layer threat detection system
    Returns: (is_malicious: bool, reason: str, severity: str, details: dict)
    """
    
    # Extract payload from multiple sources
    raw_payload = req.full_path + " " + str(req.get_data(as_text=True))
    decoded_payload = unquote_plus(raw_payload).lower()
    headers = {k.lower(): v.lower() for k, v in req.headers.items()}
    user_agent = headers.get('user-agent', '')
    
    # Run all detection layers
    checks = [
        check_sql_injection(decoded_payload),
        check_xss(decoded_payload, raw_payload),
        check_command_injection(decoded_payload),
        check_path_traversal(decoded_payload),
        check_rce(decoded_payload),
        check_xxe(decoded_payload),
        check_ssrf(decoded_payload),
        check_ldap_injection(decoded_payload),
        check_nosql_injection(decoded_payload),
        check_obfuscation(raw_payload),
        check_malicious_user_agent(user_agent),
        check_suspicious_headers(headers),
        check_file_upload_attack(req),
        check_http_smuggling(req),
    ]
    
    # Find highest severity threat
    for malicious, reason, severity, details in checks:
        if malicious:
            return True, reason, severity, details
    
    return False, None, "LOW", {}


# =========================
# LAYER 1: SQL INJECTION
# =========================
def check_sql_injection(payload):
    """Detect SQL injection attempts"""
    
    sql_patterns = [
        # Union-based
        (r"union\s+(all\s+)?select", "CRITICAL", "Union-based SQL Injection"),
        
        # Boolean-based
        (r"'\s*or\s*'1'\s*=\s*'1", "CRITICAL", "Boolean SQL Injection"),
        (r"'\s*or\s*1\s*=\s*1", "CRITICAL", "Boolean SQL Injection"),
        (r"admin'\s*--", "CRITICAL", "Comment-based SQL Injection"),
        (r"admin'\s*#", "CRITICAL", "Comment-based SQL Injection"),
        
        # Time-based blind
        (r"sleep\s*\(\s*\d+\s*\)", "HIGH", "Time-based Blind SQLi"),
        (r"benchmark\s*\(", "HIGH", "Benchmark-based SQLi"),
        (r"waitfor\s+delay", "HIGH", "Time-delay SQLi"),
        
        # Error-based
        (r"convert\s*\(\s*int", "HIGH", "Error-based SQLi"),
        (r"cast\s*\(\s*", "MEDIUM", "Type-casting SQLi"),
        
        # Stacked queries
        (r";\s*drop\s+table", "CRITICAL", "Stacked Query - DROP"),
        (r";\s*delete\s+from", "CRITICAL", "Stacked Query - DELETE"),
        (r";\s*insert\s+into", "HIGH", "Stacked Query - INSERT"),
        (r";\s*update\s+", "HIGH", "Stacked Query - UPDATE"),
        
        # Database enumeration
        (r"information_schema", "HIGH", "Database Enumeration"),
        (r"sys\.databases", "HIGH", "Database Enumeration"),
        (r"mysql\.user", "HIGH", "Database Enumeration"),
        
        # Common SQL functions
        (r"concat\s*\(", "MEDIUM", "SQL Function - CONCAT"),
        (r"substring\s*\(", "MEDIUM", "SQL Function - SUBSTRING"),
        (r"ascii\s*\(", "MEDIUM", "SQL Function - ASCII"),
        (r"version\s*\(\s*\)", "MEDIUM", "SQL Version Detection"),
        
        # SQL comments
        (r"/\*.*\*/", "MEDIUM", "SQL Comment Injection"),
        (r"--\s*$", "MEDIUM", "SQL Line Comment"),
    ]
    
    for pattern, severity, description in sql_patterns:
        if re.search(pattern, payload, re.IGNORECASE):
            return True, f"SQL_Injection: {description}", severity, {"pattern": pattern}
    
    return False, None, "LOW", {}


# =========================
# LAYER 2: XSS (Cross-Site Scripting)
# =========================
def check_xss(payload, raw_payload):
    """Detect XSS attacks"""
    
    xss_patterns = [
        # Script tags
        (r"<script[^>]*>", "CRITICAL", "Script Tag Injection"),
        (r"</script>", "CRITICAL", "Script Tag Injection"),
        (r"javascript:", "HIGH", "JavaScript Protocol"),
        
        # Event handlers
        (r"on\w+\s*=", "HIGH", "Event Handler Injection"),
        (r"onerror\s*=", "CRITICAL", "onError Handler"),
        (r"onload\s*=", "HIGH", "onLoad Handler"),
        (r"onclick\s*=", "MEDIUM", "onClick Handler"),
        (r"onmouseover\s*=", "MEDIUM", "onMouseOver Handler"),
        
        # Common XSS functions
        (r"alert\s*\(", "HIGH", "Alert Function"),
        (r"prompt\s*\(", "HIGH", "Prompt Function"),
        (r"confirm\s*\(", "MEDIUM", "Confirm Function"),
        
        # DOM manipulation
        (r"document\.cookie", "HIGH", "Cookie Theft Attempt"),
        (r"document\.write", "MEDIUM", "DOM Write"),
        (r"window\.location", "MEDIUM", "Location Redirect"),
        
        # Iframe injection
        (r"<iframe", "HIGH", "Iframe Injection"),
        (r"<embed", "HIGH", "Embed Tag Injection"),
        (r"<object", "MEDIUM", "Object Tag Injection"),
        
        # SVG-based XSS
        (r"<svg[^>]*onload", "HIGH", "SVG-based XSS"),
        
        # Data URLs
        (r"data:text/html", "MEDIUM", "Data URL Injection"),
        
        # Expression language
        (r"\$\{.*\}", "MEDIUM", "Expression Language Injection"),
    ]
    
    for pattern, severity, description in xss_patterns:
        if re.search(pattern, payload, re.IGNORECASE):
            return True, f"XSS: {description}", severity, {"pattern": pattern}
    
    # Check for HTML entity encoding evasion
    if re.search(r"&#\d+;", raw_payload) or re.search(r"&#x[0-9a-f]+;", raw_payload):
        return True, "XSS: HTML Entity Encoding", "MEDIUM", {"type": "encoded"}
    
    return False, None, "LOW", {}


