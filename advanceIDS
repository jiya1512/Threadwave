# =========================
# LAYER 10: OBFUSCATION DETECTION
# =========================
def check_obfuscation(payload):
    """Detect encoded/obfuscated payloads"""
    
    # Base64 detection (long base64 strings)
    base64_pattern = r"(?:[A-Za-z0-9+/]{40,}={0,2})"
    if re.search(base64_pattern, payload):
        try:
            # Try to decode and check content
            potential_b64 = re.findall(base64_pattern, payload)
            for b64 in potential_b64:
                try:
                    decoded = base64.b64decode(b64).decode('utf-8', errors='ignore').lower()
                    if any(word in decoded for word in ['script', 'eval', 'system', 'exec']):
                        return True, "Obfuscation: Base64 Encoded Malicious Payload", "HIGH", {"encoded": True}
                except:
                    pass
        except:
            pass
        return True, "Obfuscation: Base64 Encoded Payload", "MEDIUM", {"encoded": True}
    
    # Hex encoding
    if re.search(r"(\\x[0-9a-f]{2}){5,}", payload, re.IGNORECASE):
        return True, "Obfuscation: Hex Encoded Payload", "MEDIUM", {"encoded": True}
    
    # Unicode encoding
    if re.search(r"(\\u[0-9a-f]{4}){3,}", payload, re.IGNORECASE):
        return True, "Obfuscation: Unicode Encoded Payload", "MEDIUM", {"encoded": True}
    
    return False, None, "LOW", {}


